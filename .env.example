# Groq API Key (Get your free key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Whisper Model size (tiny, base, small, medium, large-v3)
WHISPER_MODEL=base

# Video export dimensions (Default 9:16 for Reels/Shorts/TikTok)
TARGET_WIDTH=1080
TARGET_HEIGHT=1920

# Smart Silence / Jump Cuts removal
REMOVE_SILENCE=true
SILENCE_MIN_LEN=0.6
SILENCE_THRESH=0.03

